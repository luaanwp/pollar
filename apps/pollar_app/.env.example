# Pollar — environment variables (example)
# Copy to `.env` and fill with real values. NEVER commit the real `.env`.
# These are read at build/run time; no secrets are committed to source control.

# Supabase project (local or remote). For local dev via `supabase start`,
# the CLI prints the API URL and anon key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key

# Do NOT put the service_role key in the client app. Server-only.
# SUPABASE_SERVICE_ROLE_KEY=server-side-only

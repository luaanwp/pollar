# Pollar — environment variables (example)
# Pass these with --dart-define or --dart-define-from-file. Never commit the
# real values. A publishable key is safe for a client; service_role is not.

# Supabase project (local or remote). For local dev via `supabase start`,
# the CLI prints the API URL and publishable key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-local-publishable-key

# Do NOT put the service_role key in the client app. Server-only.
# SUPABASE_SERVICE_ROLE_KEY=server-side-only
